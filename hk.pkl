// This repository's own hk config.
//
// It amends this package's Config.pkl so that the schema pin is exercised by
// the real hk binary, and it runs the hook templates and the builtins from the
// working tree. The hk version in the import below must equal the pin in
// Config.pkl. A mismatch builds different Pkl types, and hk validate rejects
// the config.
amends "Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl" as Hk

import "Hooks.pkl" as Hooks

// The templates run over this repository's own files, so a change to them is
// exercised before a release. The go, agentskills, and proto groups select no
// files here, but the config still has to build them, and `hk_test` runs the
// tests inside the steps that a group adds.
//
// `hk_test` runs the tests inside each builtin, so it belongs to the hooks
// that run commands.
hooks = (Hooks.all(List("go", "agentskills", "proto", "python"))) {
  ["check"] {
    steps {
      ["hk_test"] = Hk.hk_test
    }
  }
  ["fix"] {
    steps {
      ["hk_test"] = Hk.hk_test
    }
  }
  ["pre-commit"] {
    steps {
      ["hk_test"] = Hk.hk_test
    }
  }
}
