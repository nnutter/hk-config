import "../Config.pkl" as Config

/// Lints testify assertions with testifylint.
///
/// hk does not ship this tool. The check reports every package in the module.
/// The fix rewrites those same packages.
///
/// The released testifylint cannot load packages from the Go toolchain this
/// repository runs, so a step test cannot tell a finding from a load error.
/// The step therefore has no tests.
testifylint = new Config.Step {
  glob = List("**/*.go")
  workspace_indicator = "go.mod"
  dir = "{{workspace}}"
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("testifylint", "./...") }
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command { argv = List("testifylint", "-fix", "./...") }
    effect = "write"
  }
}
