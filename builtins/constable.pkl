import "../Config.pkl" as Config

/// Lints Go code with constable: non-mutating contracts, method order,
/// complexity, predicates, and testify usage.
///
/// `-fix` applies the method-order fixes that the methodical analyzer offers.
/// The tool rewrites a file only when Git tracks it with no changes, so the fix
/// test commits the files first.
constable = new Config.Step {
  glob = List("**/*.go")
  workspace_indicator = "go.mod"
  dir = "{{workspace}}"
  check = new Config.CommandSpec {
    command = new Config.Command { argv = List("constable", "./...") }
    effect = "read"
  }
  fix = new Config.CommandSpec {
    command = new Config.Command { argv = List("constable", "-fix", "./...") }
    effect = "write"
  }
  // The tool prints `path:line:column: message`.
  diagnostic_format = "gcc"
  tests {
    local const mutatesParameter =
      """
      package main

      //constable:nonmutating
      func reset(p *int) {
      \t*p = 0
      }

      func main() {
      \tv := 1
      \treset(&v)
      }
      """
    local const readsParameter =
      """
      package main

      //constable:nonmutating
      func read(p *int) int {
      \treturn *p
      }

      func main() {
      \tv := 1
      \t_ = read(&v)
      }
      """
    // The analyzer driver exits 3, not 1, when it reports a diagnostic.
    ["check mutated parameter"] = new Config.StepTest {
      tmpdir = true
      write {
        ["go.mod"] = "module example.com/test\n\ngo 1.21\n"
        ["main.go"] = mutatesParameter
      }
      expect { code = 3 }
    }
    ["check read-only parameter"] = new Config.StepTest {
      tmpdir = true
      write {
        ["go.mod"] = "module example.com/test\n\ngo 1.21\n"
        ["main.go"] = readsParameter
      }
      expect { code = 0 }
    }
  }
}
