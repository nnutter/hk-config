import "../Config.pkl" as Config

/// Keeps `mise.lock` in step with `mise.toml` by running `mise lock`.
///
/// hk's `mise` builtin only formats, so without this step a change to
/// `mise.toml` leaves the lockfile stale. The step only fixes, so a check hook
/// skips it and the hooks that rewrite files run it; `pre-commit` then stages
/// the regenerated `mise.lock`.
///
/// A plain `mise lock` preserves the locked versions and only refreshes their
/// checksums and URLs, or adds an entry for a tool that has none. It does not
/// advance a `latest` request to the newest release: that is `mise upgrade`'s
/// job, and the hook must not silently bump pins.
///
/// It runs at the repository root and takes no `{{files}}`: `mise lock`
/// operates on the whole current config root, and a glob-triggered network call
/// must not run when no config changed. The glob selects only the project-local
/// configs that feed the project lockfile, so a global config change does not
/// trigger a project lock.
///
/// The lockfile content is platform- and release-specific, so the fix test
/// asserts the command succeeds rather than the generated bytes; the package
/// test reads the command back.
mise_lock = new Config.Step {
  glob =
    List(
      "mise.toml",
      "mise.*.toml",
      ".mise.toml",
      ".mise.*.toml",
      "mise/config.toml",
      "mise/config.*.toml",
      ".mise/config.toml",
      ".mise/config.*.toml",
    )
  fix = new Config.CommandSpec {
    command = new Config.Command {
      argv = List("mise", "lock")
    }
    effect = "write"
  }
  tests {
    ["fix writes the lockfile"] = new Config.StepTest {
      run = "fix"
      tmpdir = true
      write { ["mise.toml"] = "[tools]\npython = \"3.14\"\n" }
      expect { code = 0 }
    }
  }
}
