import "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Builtins.pkl" as Hk

import "../Config.pkl" as Config

/// Checks `go mod tidy` without rewriting the module.
///
/// hk's builtin fixes with `go mod tidy`. A scoped fix then rewrites the
/// whole module, not only the selected files. This wrapper keeps the `-diff`
/// check and has no fix command. hk rejects `stage` without a fix command, so
/// the wrapper also clears `stage`.
gomod_tidy: Config.Step = (Hk.gomod_tidy) {
  fix = null
  stage = null
  // The stock fix tests expect `go mod tidy` to rewrite the module.
  tests = new Mapping<String, Config.StepTest> {
    for (name, test in Hk.gomod_tidy.tests) {
      when (test.run != "fix") {
        [name] = test
      }
    }
  }
}
